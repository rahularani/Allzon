# ALLZON Buyer Application - Environment Configuration Example

# ==============================================================================
# API CONFIGURATION (Required)
# ==============================================================================
# The base URL of the ALLZON backend API
# Ensure this matches your backend's host and port
VITE_API_BASE_URL=<BACKEND_API_URL>

# ==============================================================================
# SIBLING PORTALS CONFIGURATION
# ==============================================================================
# The public URLs for the Supplier and Admin portals.
# Required in production to correctly cross-link user navigation.
VITE_SUPPLIER_APP_URL=
VITE_ADMIN_APP_URL=
